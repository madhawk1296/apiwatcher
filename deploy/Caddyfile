# Caddy terminates TLS with an automatic Let's Encrypt certificate and proxies
# to the server on localhost. Replace the hostname; nothing else to configure.
#
# Install: cp deploy/Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy

app.example.com {
	encode gzip
	reverse_proxy localhost:8787

	# GitHub webhook bodies are small; anything larger is not GitHub.
	request_body {
		max_size 2MB
	}
}
