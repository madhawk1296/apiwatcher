# /etc/apiwatcher/env — read by systemd. chmod 600, owned by root.
#
# Required
APP_ID=
# The .pem GitHub generated for the App. Keep it as a file, not inline.
APP_PRIVATE_KEY_FILE=/etc/apiwatcher/app-private-key.pem
# Same value as the App's webhook secret on GitHub.
WEBHOOK_SECRET=

# Strongly recommended: gates /admin/*. Generate with `openssl rand -hex 32`.
ADMIN_TOKEN=

# Dashboard (Next.js). AUTH_GITHUB_* are the GitHub App's OAuth client id/secret —
# from the App's settings page, "Identifying and authorizing users". A separate
# OAuth App will NOT work: its tokens cannot list this App's installations.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The public origin, e.g. https://app.example.com — must match the App's callback URL.
AUTH_URL=
# Where the web app reaches the scan server. Same box, loopback.
SERVER_URL=http://127.0.0.1:8787

# Version digest (email + Slack). Without RESEND_API_KEY, digests are logged, not sent.
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=apiwatcher <alerts@example.com>

# Optional, with defaults
PORT=8787
DATA_DIR=/var/lib/apiwatcher
SCAN_CONCURRENCY=2
POLL_INTERVAL_MINUTES=60
REPORT_RETENTION_DAYS=30
APP_SLUG=apiwatcher-app
# CHANGESET_INDEX_URL=https://raw.githubusercontent.com/madhawk1296/apiwatcher/main/changesets/stripe/index.json
