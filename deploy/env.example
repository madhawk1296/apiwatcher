# /etc/apiwatcher/env — read by systemd. chmod 600, owned by root.
#
# Required
APP_ID=
# The .pem GitHub generated for the App. Keep it as a file, not inline.
APP_PRIVATE_KEY_FILE=/etc/apiwatcher/app-private-key.pem
# Same value as the App's webhook secret on GitHub.
WEBHOOK_SECRET=

# Strongly recommended: gates /admin/*. Generate with `openssl rand -hex 32`.
ADMIN_TOKEN=

# Optional, with defaults
PORT=8787
DATA_DIR=/var/lib/apiwatcher
SCAN_CONCURRENCY=2
POLL_INTERVAL_MINUTES=60
REPORT_RETENTION_DAYS=30
APP_SLUG=apiwatcher-app
# CHANGESET_INDEX_URL=https://raw.githubusercontent.com/madhawk1296/apiwatcher/main/changesets/stripe/index.json
