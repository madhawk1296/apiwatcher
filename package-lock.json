{
  "name": "apiwatcher-monorepo",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "apiwatcher-monorepo",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@apiwatcher/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@types/node": {
      "version": "22.20.2",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "undici-types": "~6.21.0"
      }
    },
    "node_modules/apiwatcher-cli": {
      "resolved": "packages/apiwatcher",
      "link": true
    },
    "node_modules/stripe": {
      "version": "22.6.2",
      "dev": true,
      "license": "MIT",
      "engines": {
        "node": ">=18"
      },
      "peerDependencies": {
        "@types/node": ">=18"
      },
      "peerDependenciesMeta": {
        "@types/node": {
          "optional": true
        }
      }
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "6.21.0",
      "dev": true,
      "license": "MIT"
    },
    "packages/apiwatcher": {
      "name": "apiwatcher-cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "typescript": "^5.6.0"
      },
      "bin": {
        "apiwatcher": "dist/cli/index.js"
      },
      "devDependencies": {
        "@types/node": "^22.0.0",
        "stripe": "^22.6.2"
      }
    },
    "packages/server": {
      "name": "@apiwatcher/server",
      "version": "0.1.0",
      "dependencies": {
        "apiwatcher-cli": "0.1.0"
      },
      "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.6.0"
      },
      "engines": {
        "node": ">=22.13"
      }
    }
  }
}
